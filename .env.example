# Server
PORT=5173
HOST=0.0.0.0

# Public browser config. This key is used by NAVER Maps JavaScript in the browser.
NAVER_MAP_NCP_KEY_ID=

# Server-only public data service key. Do not put this value in public/config.js.
PUBLIC_DATA_SERVICE_KEY=
# DATA_GO_KR_SERVICE_KEY=
# EV_CHARGER_SERVICE_KEY=

# SQLite cache
NEARBY_STATION_DB=data/stations.sqlite
NEARBY_RESPONSE_CACHE_MS=120000
NEARBY_AUTO_REFRESH=0
NEARBY_AUTO_REFRESH_INTERVAL_MS=21600000

# Public data refresh options
NEARBY_DATA_PAGE_SIZE=9999
NEARBY_DATA_MAX_PAGES=
NEARBY_DATA_ZCODE=
NEARBY_DATA_ZCODES=
NEARBY_DATA_ZSCODE=
NEARBY_STATUS_STALE_HOURS=24

# Optional local CSV bootstrap path
NEARBY_KEPCO_CSV_PATH=
